/*
 * SplitPad: wireless split, 23 keys per hand (Choc v2), Azoteq TPS43 trackpad on each half.
 * MCU: Seeed XIAO nRF52840 Plus (built with the seeeduino_xiao_ble board).
 * Both halves use the same schematic, so pins are identical. The right XIAO is
 * mounted rotated 270 deg, which does not change the electrical assignment.
 *
 * Pins (schematic net -> XIAO pin -> nRF52840 GPIO)
 *   Row1 D0  P0.02   Col1 D6  P1.11   SDA    D4  P0.04 (xiao_i2c)
 *   Row2 D1  P0.03   Col2 D7  P1.12   SCL    D5  P0.05 (xiao_i2c)
 *   Row3 D2  P0.28   Col3 D8  P1.13   TP_RDY D18 P1.05 (back pad, "NFC2" in the schematic)
 *   Row4 D3  P0.29   Col4 D9  P1.14   TP_RST tied to 3V3 (no GPIO)
 *                    Col5 D10 P1.15   BAT    on-board divider (board default, P0.31 / P0.14)
 *                    Col6 D19 P1.07 (back pad, "NFC1" in the schematic)
 *
 * Diodes: Col -> switch -> diode anode, cathode -> Row  =>  col2row.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row1 D0 */
            , <&gpio0 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row2 D1 */
            , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row3 D2 */
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row4 D3 */
            ;
        col-gpios
            = <&gpio1 11 GPIO_ACTIVE_HIGH>  /* Col1 D6  */
            , <&gpio1 12 GPIO_ACTIVE_HIGH>  /* Col2 D7  */
            , <&gpio1 13 GPIO_ACTIVE_HIGH>  /* Col3 D8  */
            , <&gpio1 14 GPIO_ACTIVE_HIGH>  /* Col4 D9  */
            , <&gpio1 15 GPIO_ACTIVE_HIGH>  /* Col5 D10 */
            , <&gpio1 7  GPIO_ACTIVE_HIGH>  /* Col6 D19 (back pad) */
            ;
    };

    /*
     * Matrix: 4 rows x 6 cols per half. The right half is offset by 6 columns.
     * Col1 is the outer (pinky) column on both halves.
     *   SW1-4 Col1, SW5-8 Col2, SW9-12 Col3, SW13-16 Col4, SW17-20 Col5 (Row1..Row4)
     *   SW21 Col6/Row2 (inner key at row-3 height), SW22 Col6/Row3 (thumb), SW23 Col6/Row4 (thumb)
     *   Col6/Row1 has no switch.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                  RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                  RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(1,5)  RC(1,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)                  RC(3,10) RC(3,9) RC(3,8) RC(3,7) RC(3,6)
                                        RC(2,5) RC(3,5)  RC(3,11) RC(2,11)
        >;
    };

    /* Key positions from the KiCad boards (17 mm = 100). Used by ZMK Studio. */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  //                     w   h    x    y     rot   rx   ry
            = <&key_physical_attrs 100 100    0   50       0    0    0>  // L SW1
            , <&key_physical_attrs 100 100  100   12       0    0    0>  // L SW5
            , <&key_physical_attrs 100 100  200    0       0    0    0>  // L SW9
            , <&key_physical_attrs 100 100  300   12       0    0    0>  // L SW13
            , <&key_physical_attrs 100 100  400   25       0    0    0>  // L SW17
            , <&key_physical_attrs 100 100 1129   25       0    0    0>  // R SW17
            , <&key_physical_attrs 100 100 1229   12       0    0    0>  // R SW13
            , <&key_physical_attrs 100 100 1329    0       0    0    0>  // R SW9
            , <&key_physical_attrs 100 100 1429   12       0    0    0>  // R SW5
            , <&key_physical_attrs 100 100 1529   50       0    0    0>  // R SW1
            , <&key_physical_attrs 100 100    0  150       0    0    0>  // L SW2
            , <&key_physical_attrs 100 100  100  112       0    0    0>  // L SW6
            , <&key_physical_attrs 100 100  200  100       0    0    0>  // L SW10
            , <&key_physical_attrs 100 100  300  112       0    0    0>  // L SW14
            , <&key_physical_attrs 100 100  400  125       0    0    0>  // L SW18
            , <&key_physical_attrs 100 100 1129  125       0    0    0>  // R SW18
            , <&key_physical_attrs 100 100 1229  112       0    0    0>  // R SW14
            , <&key_physical_attrs 100 100 1329  100       0    0    0>  // R SW10
            , <&key_physical_attrs 100 100 1429  112       0    0    0>  // R SW6
            , <&key_physical_attrs 100 100 1529  150       0    0    0>  // R SW2
            , <&key_physical_attrs 100 100    0  250       0    0    0>  // L SW3
            , <&key_physical_attrs 100 100  100  212       0    0    0>  // L SW7
            , <&key_physical_attrs 100 100  200  200       0    0    0>  // L SW11
            , <&key_physical_attrs 100 100  300  212       0    0    0>  // L SW15
            , <&key_physical_attrs 100 100  400  225       0    0    0>  // L SW19
            , <&key_physical_attrs 100 100  500  250       0    0    0>  // L SW21 (inner)
            , <&key_physical_attrs 100 100 1029  250       0    0    0>  // R SW21 (inner)
            , <&key_physical_attrs 100 100 1129  225       0    0    0>  // R SW19
            , <&key_physical_attrs 100 100 1229  212       0    0    0>  // R SW15
            , <&key_physical_attrs 100 100 1329  200       0    0    0>  // R SW11
            , <&key_physical_attrs 100 100 1429  212       0    0    0>  // R SW7
            , <&key_physical_attrs 100 100 1529  250       0    0    0>  // R SW3
            , <&key_physical_attrs 100 100    0  350       0    0    0>  // L SW4
            , <&key_physical_attrs 100 100  100  312       0    0    0>  // L SW8
            , <&key_physical_attrs 100 100  200  300       0    0    0>  // L SW12
            , <&key_physical_attrs 100 100  300  312       0    0    0>  // L SW16
            , <&key_physical_attrs 100 100  400  325       0    0    0>  // L SW20
            , <&key_physical_attrs 100 100 1129  325       0    0    0>  // R SW20
            , <&key_physical_attrs 100 100 1229  312       0    0    0>  // R SW16
            , <&key_physical_attrs 100 100 1329  300       0    0    0>  // R SW12
            , <&key_physical_attrs 100 100 1429  312       0    0    0>  // R SW8
            , <&key_physical_attrs 100 100 1529  350       0    0    0>  // R SW4
            , <&key_physical_attrs 100 100  507  365    1500  557  415>  // L SW22 thumb
            , <&key_physical_attrs 100 100  613  409    3000  663  459>  // L SW23 thumb
            , <&key_physical_attrs 100 100  916  409 (-3000)  966  459>  // R SW23 thumb
            , <&key_physical_attrs 100 100 1022  365 (-1500) 1072  415>  // R SW22 thumb
            ;
    };

    /*
     * Trackpads
     *   right (central):    mouse cursor, read directly (enabled in splitpad_right.overlay)
     *   left  (peripheral): forwarded to the right half over BLE via left_tp_split,
     *                       one-finger movement is turned into scrolling
     */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        left_tp_split: left_tp_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    left_tp_listener: left_tp_listener {
        compatible = "zmk,input-listener";
        device = <&left_tp_split>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 16>;
    };

    right_tp_listener: right_tp_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&tps43>;
    };
};

&xiao_i2c {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    /* TPS43 (IQS572). The 4.7k pull-ups R1/R2 on the PCB are optional. */
    tps43: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        status = "okay";
        rdy-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;  /* TP_RDY D18 (back pad) */
        /* no reset-gpios: NRST is tied to 3V3 on the PCB */

        one-finger-tap;
        two-finger-tap;
        press-and-hold;
        press-and-hold-time = <250>;
        scroll;

        bottom-beta = <5>;
        stationary-threshold = <5>;

        /* Axis direction: set after the first test (switch-xy / flip-x / flip-y). */
    };
};
