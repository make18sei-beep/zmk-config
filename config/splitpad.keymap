/*
 * SplitPad keymap (first draft, based on keyboard-layout_v7.json).
 * Can be changed later from ZMK Studio (https://zmk.studio/) without reflashing.
 *
 * Host: Windows. "English" key = Muhenkan (IME off), "Kana" key = Henkan (IME on)
 * -> set these in the Microsoft IME key settings.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define FN   1
#define SYS  2

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp Q     &kp W    &kp E     &kp R    &kp T                                       &kp Y      &kp U     &kp I     &kp O    &kp P
&kp A     &kp S    &kp D     &kp F    &kp G                                       &kp H      &kp J     &kp K     &kp L    &kp SEMI
&kp Z     &kp X    &kp C     &kp V    &kp INT_MUHENKAN &kp INT_HENKAN   &kp B     &kp N      &kp M     &kp COMMA &kp DOT  &kp FSLH
&kp LCTRL &kp LGUI &mo FN    &kp LALT &kp TAB                                     &mkp LCLK  &mkp RCLK &kp MINUS &kp SQT  &kp ESC
                                               &kp DEL  &kp SPACE   &kp RET  &kp BSPC
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
&kp N1    &kp N2    &kp N3    &kp N4    &kp N5                                    &kp N6     &kp N7     &kp N8     &kp N9    &kp N0
&kp ESC   &kp GRAVE &kp LBKT  &kp RBKT  &kp BSLH                                  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT &kp EQUAL
&kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F11              &kp F12    &kp F6     &kp F7     &kp F8     &kp F9    &kp F10
&trans    &trans    &trans    &trans    &trans                                    &kp HOME   &kp PG_DN  &kp PG_UP  &kp END   &mo SYS
                                                  &trans  &trans       &trans  &trans
            >;
        };

        sys_layer {
            display-name = "Sys";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_CLR  &out OUT_USB  &out OUT_BLE  &studio_unlock  &none
&none         &none         &none         &none         &none                                &none       &none         &none         &none           &none
&bootloader   &sys_reset    &none         &none         &none         &none         &none    &none       &none         &none         &sys_reset      &bootloader
&trans        &trans        &trans        &trans        &trans                               &none       &none         &none         &none           &trans
                                                        &none         &none         &none    &none
            >;
        };
    };
};
